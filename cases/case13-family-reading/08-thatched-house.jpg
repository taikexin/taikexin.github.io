<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0e5b49">
  <meta name="description" content="晶晶老师的 AI 教育助理：13 个可直接体验的学习案例，包含 AI 教育深读、少年三国亲历阅读和家庭童书精读系统。">
  <link rel="preload" as="image" href="直播展示资源/品牌照片/晶晶老师与女儿-夏日同框-2026.jpg">
  <title>晶晶老师的 AI 教育助理</title>
  <style>
    :root {
      --ink: #15332d;
      --muted: #63756f;
      --paper: #f4f6f3;
      --panel: #ffffff;
      --line: #d7e1dc;
      --green: #176f58;
      --green-dark: #0d493b;
      --coral: #ef6955;
      --yellow: #f4c84b;
      --blue: #3272bd;
      --focus: #155cc7;
      --shadow: 0 18px 42px rgba(24, 51, 45, .11);
    }

    * { box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      min-width: 320px;
      margin: 0;
      color: var(--ink);
      background: var(--paper);
      font-family: "Microsoft YaHei", "PingFang SC", system-ui, sans-serif;
      line-height: 1.55;
      letter-spacing: 0;
    }

    button, input { font: inherit; letter-spacing: 0; }

    button, a { -webkit-tap-highlight-color: transparent; }

    button:focus-visible, a:focus-visible, input:focus-visible {
      outline: 3px solid var(--focus);
      outline-offset: 3px;
    }

    .hero {
      position: relative;
      min-height: 500px;
      height: min(540px, calc(100vh - 80px));
      max-height: 600px;
      overflow: hidden;
      color: #fff;
      background: #6c9862 url("直播展示资源/品牌照片/晶晶老师与女儿-夏日同框-2026.jpg") center 46% / cover no-repeat;
      border-bottom: 6px solid var(--yellow);
    }

    .hero::before {
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, rgba(4, 38, 30, .68), rgba(4, 38, 30, .11) 72%);
      content: "";
    }

    .hero::after {
      position: absolute;
      right: 0;
      bottom: 0;
      left: 0;
      height: 43%;
      background: rgba(7, 45, 37, .88);
      content: "";
      pointer-events: none;
    }

    .hero-inner, .content { width: min(1280px, calc(100% - 64px)); margin: 0 auto; }

    .hero-inner {
      position: relative;
      z-index: 1;
      display: flex;
      min-height: 500px;
      height: 100%;
      flex-direction: column;
      justify-content: space-between;
      padding: 22px 0 34px;
    }

    .brand {
      display: inline-flex;
      width: fit-content;
      align-items: center;
      gap: 11px;
      font-size: 16px;
      font-weight: 900;
      text-shadow: 0 2px 10px rgba(0, 0, 0, .34);
    }

    .brand-mark {
      display: grid;
      width: 36px;
      height: 36px;
      place-items: center;
      border: 2px solid rgba(255, 255, 255, .84);
      border-radius: 50%;
      background: var(--yellow);
      color: var(--green-dark);
      font-family: Georgia, serif;
      font-size: 19px;
      text-shadow: none;
    }

    .brand-copy { display: grid; gap: 1px; }
    .brand-copy small { font-size: 11px; font-weight: 700; opacity: .88; }

    .hero-copy { max-width: 700px; }
    .eyebrow, .story-kicker {
      margin: 0 0 10px;
      color: #f8db74;
      font-size: 13px;
      font-weight: 900;
    }

    h1, h2, h3, p { margin-top: 0; }

    h1 {
      max-width: 560px;
      margin-bottom: 12px;
      font-family: Georgia, "Songti SC", serif;
      font-size: clamp(38px, 5vw, 64px);
      line-height: 1.08;
      letter-spacing: 0;
    }

    .hero-copy > p:last-child { max-width: 590px; margin-bottom: 0; font-size: 17px; font-weight: 700; }

    .story {
      display: grid;
      grid-template-columns: minmax(280px, .9fr) minmax(360px, 1.1fr);
      width: min(1180px, calc(100% - 64px));
      margin: 0 auto;
      gap: clamp(30px, 7vw, 98px);
      padding: 86px 0 82px;
    }

    .story-visual { position: relative; min-height: 420px; margin: 0; overflow: hidden; background: #d6e1d5; }
    .story-visual::after { position: absolute; inset: auto 0 0; height: 32%; background: linear-gradient(transparent, rgba(7, 45, 37, .32)); content: ""; }
    .story-visual img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center 30%; }

    .story-copy { align-self: center; }
    .story-kicker { color: var(--green); }
    .story h2 { margin-bottom: 18px; color: var(--green-dark); font-size: clamp(30px, 3.8vw, 48px); line-height: 1.18; }
    .story-lead { margin-bottom: 25px; color: #425b54; font-size: 17px; }

    .principles { display: grid; gap: 0; border-top: 1px solid var(--line); }
    .principle { display: grid; grid-template-columns: 52px 88px 1fr; gap: 9px; align-items: baseline; padding: 14px 0; border-bottom: 1px solid var(--line); color: var(--muted); font-size: 14px; }
    .principle-index { color: var(--coral); font-weight: 900; }
    .principle strong { color: var(--ink); font-size: 16px; }

    main { padding-bottom: 90px; }
    .controls-band { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: #fff; }
    .controls { display: flex; align-items: center; justify-content: space-between; gap: 22px; padding: 22px 0; }
    .filters { display: flex; flex-wrap: wrap; gap: 9px; }
    .filter {
      min-height: 39px;
      padding: 7px 14px;
      border: 1px solid var(--line);
      border-radius: 4px;
      background: #fff;
      color: var(--ink);
      cursor: pointer;
      font-weight: 800;
    }
    .filter:hover { border-color: var(--green); color: var(--green-dark); }
    .filter.is-active { border-color: var(--green); background: var(--green); color: #fff; }

    .search-wrap { position: relative; display: block; min-width: min(300px, 100%); }
    .search {
      width: 100%;
      min-height: 42px;
      padding: 8px 13px;
      border: 1px solid var(--line);
      border-radius: 4px;
      background: #f9fbfa;
      color: var(--ink);
    }
    .search::placeholder { color: #86948f; }

    .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 20px; padding: 54px 0 26px; }
    .section-heading h2 { margin: 0; color: var(--green-dark); font-size: clamp(27px, 3vw, 39px); line-height: 1.2; }
    #resultText { margin: 0; color: var(--muted); font-size: 14px; font-weight: 700; }

    .projects { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
    .project { min-width: 0; border: 1px solid var(--line); border-radius: 6px; overflow: hidden; background: var(--panel); box-shadow: 0 5px 18px rgba(24, 51, 45, .04); }
    .project-link { display: block; height: 100%; color: inherit; text-decoration: none; }
    .project-link:hover { box-shadow: 0 12px 28px rgba(24, 51, 45, .13); transform: translateY(-3px); }
    .project-link, .project-media img { transition: transform .2s ease, box-shadow .2s ease; }
    .project-media { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: #e2ece7; }
    .project-media img { display: block; width: 100%; height: 100%; object-fit: cover; }
    .project-link:hover .project-media img { transform: scale(1.035); }
    .project-number { position: absolute; top: 12px; left: 12px; display: grid; width: 33px; height: 33px; place-items: center; border: 1px solid rgba(255, 255, 255, .7); border-radius: 50%; background: rgba(13, 73, 59, .88); color: #fff; font-size: 12px; font-weight: 900; }
    .project-body { display: flex; min-height: 190px; flex-direction: column; padding: 17px 18px 16px; }
    .project-meta { display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 11px; font-size: 12px; font-weight: 900; }
    .domain, .project-type { padding: 3px 7px; border-radius: 3px; }
    .domain { background: #dcefe8; color: var(--green-dark); }
    .project-type { background: #fff5d4; color: #795b05; }
    .project-body h3 { margin-bottom: 9px; color: var(--ink); font-size: 19px; line-height: 1.3; }
    .project-copy { margin-bottom: 14px; color: var(--muted); font-size: 14px; }
    .project-action { display: inline-flex; align-items: center; gap: 7px; margin-top: auto; color: var(--green); font-size: 14px; font-weight: 900; }
    .arrow { font-size: 18px; line-height: 1; }
    .empty { display: none; min-height: 180px; place-items: center; border: 1px dashed var(--line); color: var(--muted); font-weight: 700; }

    footer { border-top: 5px solid var(--yellow); background: var(--green-dark); color: rgba(255, 255, 255, .86); }
    .footer-inner { width: min(1280px, calc(100% - 64px)); margin: 0 auto; padding: 25px 0; font-size: 14px; font-weight: 700; }

    @media (max-width: 980px) {
      .projects { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .story { grid-template-columns: minmax(250px, .85fr) minmax(300px, 1.15fr); gap: 38px; }
      .controls { align-items: stretch; flex-direction: column; }
      .search-wrap { width: min(440px, 100%); }
    }

    @media (max-width: 670px) {
      .hero { min-height: 480px; height: 540px; }
      .hero::before { background: linear-gradient(90deg, rgba(4, 38, 30, .75), rgba(4, 38, 30, .25)); }
      .hero-inner, .content, .footer-inner { width: min(100% - 32px, 1280px); }
      .hero-inner { min-height: 480px; padding: 17px 0 28px; }
      h1 { font-size: 41px; }
      .hero-copy > p:last-child { font-size: 15px; }
      .story { grid-template-columns: 1fr; width: min(100% - 32px, 1180px); gap: 30px; padding: 55px 0; }
      .story-visual { min-height: 340px; }
      .principle { grid-template-columns: 45px 72px 1fr; }
      .section-heading { align-items: start; flex-direction: column; padding: 40px 0 21px; gap: 8px; }
      .projects { grid-template-columns: 1fr; gap: 18px; }
      .project-body { min-height: 170px; }
      .filters { gap: 7px; }
      .filter { flex: 1 0 auto; }
    }
  </style>
</head>
<body>
  <header class="hero">
    <div class="hero-inner">
      <div class="brand" aria-label="晶晶老师的 AI 教育助理">
        <span class="brand-mark" aria-hidden="true">晶</span>
        <span class="brand-copy"><strong>晶晶老师的 AI 教育助理</strong><small>主讲老师完整体验版 · v4.8.2</small></span>
      </div>
      <div class="hero-copy">
        <p class="eyebrow">从陪伴出发 · 向成长而行</p>
        <h1>晶晶老师的<br>AI 教育助理</h1>
        <p>把一位妈妈对孩子的理解，变成有温度、能完成、愿意继续的学习体验。</p>
      </div>
    </div>
  </header>

  <section class="story" aria-labelledby="storyTitle">
    <figure class="story-visual"><img src="直播展示资源/品牌照片/晶晶老师与女儿-街拍合影.jpg" alt="晶晶老师牵着女儿一起向前走" width="1275" height="1699"></figure>
    <div class="story-copy">
      <p class="story-kicker">MOTHER · TEACHER · CREATOR</p>
      <h2 id="storyTitle">先理解孩子，<br>再设计学习。</h2>
      <p class="story-lead">我是晶晶老师，也是一位陪孩子长大的妈妈。真实的家庭陪伴让我更在意：孩子能不能看懂、愿不愿开始、遇到困难后还能不能走下去。AI 是工具，理解孩子才是学习设计的起点。</p>
      <div class="principles" aria-label="学习设计原则">
        <div class="principle"><span class="principle-index">01</span><strong>看得懂</strong><span>信息清楚，路径简单，孩子知道下一步做什么。</span></div>
        <div class="principle"><span class="principle-index">02</span><strong>愿意学</strong><span>让探索、反馈与成就感自然发生。</span></div>
        <div class="principle"><span class="principle-index">03</span><strong>能完成</strong><span>每个项目都有完整体验和可抵达的终点。</span></div>
      </div>
    </div>
  </section>

  <main>
    <div class="controls-band">
      <div class="content controls">
        <div class="filters" role="group" aria-label="按学科筛选">
          <button class="filter is-active" type="button" data-domain="" aria-pressed="true">全部学科</button>
          <button class="filter" type="button" data-domain="数学" aria-pressed="false">数学</button>
          <button class="filter" type="button" data-domain="英语" aria-pressed="false">英语</button>
          <button class="filter" type="button" data-domain="语文" aria-pressed="false">语文</button>
          <button class="filter" type="button" data-domain="拆书" aria-pressed="false">拆书</button>
          <button class="filter" type="button" data-domain="阅读" aria-pressed="false">阅读</button>
        </div>
        <label class="search-wrap"><span hidden>搜索学习案例</span><input class="search" id="searchInput" type="search" placeholder="搜索案例名称或学习主题" autocomplete="off"></label>
      </div>
    </div>
    <section class="content" aria-label="项目案例">
      <div class="section-heading"><p id="resultText" aria-live="polite">数学、英语、语文、拆书与阅读</p></div>
      <div class="projects" id="projects"></div>
      <div class="empty" id="emptyState">没有找到匹配的案例，请换个关键词试试。</div>
    </section>
  </main>

  <footer><div class="footer-inner">晶晶老师的 AI 教育助理 · 主讲老师完整体验版 · v4.8.2 主页展示优化</div></footer>

  <script>
    const projects = [
      { id: "01", name: "数学总览探险岛", domain: "数学", type: "五站复习", copy: "把百分数、分数、比和圆串成一条复习路线。", image: "直播展示资源/01-数学总览探险岛-预览.png", href: "01-数学-总览探险岛/01-数学探险岛-五站复习完整体验版.html", keywords: "六年级 知识总览 滑块 练习" },
      { id: "02", name: "圆柱 3D 工坊", domain: "数学", type: "六站探究", copy: "旋转、调参并计算，在立体观察中理解圆柱。", image: "直播展示资源/02-圆柱3D工坊-预览.png", href: "02-数学-圆柱3D工坊/02-圆柱3D工坊-六站探究完整体验版.html", keywords: "圆柱 3D 表面积 体积 几何" },
      { id: "03", name: "扇形几何工坊", domain: "数学", type: "五站探索", copy: "动手改变半径和圆心角，探索扇形周长与面积。", image: "直播展示资源/03-扇形几何工坊-预览.png", href: "03-数学-扇形几何工坊/03-扇形几何工坊-五站探索完整体验版.html", keywords: "扇形 圆心角 周长 面积 Canvas" },
      { id: "04", name: "百分数生活岛", domain: "数学", type: "生活应用", copy: "从互化到折扣与利息，把百分数放回生活情境。", image: "直播展示资源/04-百分数生活岛-预览.png", href: "04-数学-百分数生活岛/04-百分数生活岛-五站应用完整体验版.html", keywords: "百分数 互化 单位1 折扣 利息" },
      { id: "05", name: "比和比例任务营", domain: "数学", type: "五站实践", copy: "用调配、转换和生活问题掌握比与比例。", image: "直播展示资源/05-比和比例任务营-预览.png", href: "05-数学-比和比例任务营/05-比和比例任务营-五站实践完整体验版.html", keywords: "比 比例 单位1 应用题 任务" },
      { id: "06", name: "缠绳线段图实验室", domain: "数学", type: "三步推理", copy: "借助线段图拆开差量关系，完成建模推理。", image: "直播展示资源/06-缠绳线段图实验室-预览.png", href: "06-数学-缠绳线段图实验室/06-缠绳线段图实验室-三步推理完整体验版.html", keywords: "缠绳 线段图 差量 建模 推理" },
      { id: "07", name: "词语能量岛", domain: "英语", type: "听说读写", copy: "通过发音、辨词、分类和拼写完成英语词汇训练。", image: "直播展示资源/07-词语能量岛-预览.png", href: "07-英语-词语能量岛训练营/07-词语能量岛-听说读写完整体验版.html", keywords: "英语 语音 朗读 听力 分类 拼写" },
      { id: "08", name: "大观园阅读地图", domain: "语文", type: "名著共读", copy: "沿园景与人物关系进入名著，边探索边梳理线索。", image: "直播展示资源/08-大观园阅读地图-预览.png", href: "08-语文-大观园阅读地图/08-大观园阅读地图-园景人物完整体验版.html", keywords: "红楼梦 大观园 人物关系 名著 阅读" },
      { id: "09", name: "识字小花园", domain: "语文", type: "测评与学习", copy: "从识字测评到生字复习，记录孩子的汉字成长。", image: "直播展示资源/09-识字小花园-预览.png", href: "09-语文-识字小花园/09-识字小花园-测评学习完整体验版.html", keywords: "识字 测评 成语 生字库 报告" },
      { id: "10", name: "小鹿拆书工坊 · AI 教育深读", domain: "拆书", type: "15 本主题深读 · 完整阅读工坊", copy: "预设 15 本 AI 与教育书，输入书名即可获得深读线、直播讲法与孩子行动任务；补充目录或书摘后可继续做材料拆解。", image: "直播展示资源/10-AI拆书-预览.png", href: "10-拆书-AI深度阅读/小鹿阅读导览工坊-完整本地版/index.html", keywords: "AI 拆书 小鹿 深读 Robot-Proof 李飞飞 AI教育 书目 检索 直播 本地" },
      { id: "11", name: "少年三国 · 亲历身份闯关", domain: "阅读", type: "身份开场 · 自由点选", copy: "化身张飞家的小伙计，进入故事、亲历、闯关与战利品；孩子可自由选择体验环节。", image: "直播展示资源/11-三国阅读-预览.png", href: "11-阅读-少年三国亲历版/index.html", keywords: "三国演义 名著 张飞 小伙计 亲历 身份 朗读 情节 人物 闯关" },
      { id: "12", name: "佳萱的英语学习平台", domain: "英语", type: "学习档案 · 亲子英语", copy: "把老师作业、词汇练习、亲子跟读和学习成长整理在一个可持续使用的英语学习空间。", image: "直播展示资源/12-佳萱英语学习平台-预览.png", href: "12-英语-佳萱英语学习平台/index.html", keywords: "英语 作业 导入 单词 跟读 练习 档案 亲子 学习成长" },
      { id: "13", name: "读书有光 · 家庭童书精读", domain: "阅读", type: "成人 AI 课 · 12 本预设书", copy: "选择一部童书，生成 7/15/21 天家庭精读路线；把故事主线、人物主题、深度解析、词句练习与亲子共读组织成可完成的阅读计划。", image: "直播展示资源/13-童书精读系统-预览.png", href: "13-阅读-童书精读系统/index.html", keywords: "童书 精读 家庭阅读 成人AI课 7天 15天 21天 夏洛的网 亲子共读 阅读计划 证据提问" }
    ];

    const projectContainer = document.getElementById("projects");
    const searchInput = document.getElementById("searchInput");
    const emptyState = document.getElementById("emptyState");
    const resultText = document.getElementById("resultText");
    const filterButtons = [...document.querySelectorAll(".filter")];
    let activeDomain = "";

    function renderProjects() {
      const query = searchInput.value.trim().toLowerCase();
      const visible = projects.filter((project) => {
        const matchesDomain = !activeDomain || project.domain === activeDomain;
        const haystack = [project.name, project.domain, project.type, project.copy, project.keywords].join(" ").toLowerCase();
        return matchesDomain && (!query || haystack.includes(query));
      });
      projectContainer.innerHTML = visible.map((project) => `
        <article class="project">
          <a class="project-link" href="${project.href}" target="_blank" rel="noopener noreferrer" aria-label="打开${project.name}">
            <div class="project-media"><img src="${project.image}" alt="${project.name}实际页面预览" loading="lazy" width="1280" height="720"><span class="project-number" aria-hidden="true">${project.id}</span></div>
            <div class="project-body"><div class="project-meta"><span class="domain">${project.domain}</span><span class="project-type">${project.type}</span></div><h3>${project.name}</h3><p class="project-copy">${project.copy}</p><span class="project-action">进入案例 <span class="arrow" aria-hidden="true">→</span></span></div>
          </a>
        </article>`).join("");
      emptyState.style.display = visible.length ? "none" : "grid";
      resultText.textContent = visible.length ? `${activeDomain || "全部"} · ${visible.length} 个案例` : "暂无匹配案例";
    }

    filterButtons.forEach((button) => button.addEventListener("click", () => {
      activeDomain = button.dataset.domain;
      filterButtons.forEach((item) => { const active = item === button; item.classList.toggle("is-active", active); item.setAttribute("aria-pressed", String(active)); });
      renderProjects();
    }));
    searchInput.addEventListener("input", renderProjects);
    renderProjects();
  </script>
</body>
</html>
